# Database
DB_ECHO=False

# ChromaDB 
CHROMA_PERSIST_DIR=./data/chromadb

# OpenSearch Vector Store / Required only if you use opensearch or both as vector_store_type on any project
OPENSEARCH_HOST=opensearch.domain.local
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=passwordtochange
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
# Must match your embedding model output dimension:
#   all-MiniLM-L6-v2      → 384  (default)
#   all-mpnet-base-v2     → 768
OPENSEARCH_EMBEDDING_DIM=384

# JWT Authentication
SECRET_KEY=SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80

# API Keys Encryption
ENCRYPTION_KEY=ENCRYPTION_KEY=

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Streaming
STREAM_TIMEOUT=300
HEARTBEAT_INTERVAL=15
MAX_RECONNECT_ATTEMPTS=5
BUFFER_SIZE=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
